{
  "name": "vietnamsparkle-firestore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/check-template.mjs",
    "demo": "node scripts/template-demo.mjs",
    "demo:prepare": "node scripts/template-demo.mjs --prepare-only",
    "demo:seed": "node scripts/seed-template-demo.mjs",
    "emulators": "firebase emulators:start --only auth,firestore,functions,hosting --import=emulator-data --export-on-exit=emulator-data",
    "seed:emulator": "node src/scripts/seedEmulatorProducts.js",
    "import:sheets": "node src/scripts/importSheetsJson.js",
    "set:claims": "node src/scripts/setUserClaims.js"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "firebase-admin": "^12.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-tools": "^15.22.4"
  }
}
